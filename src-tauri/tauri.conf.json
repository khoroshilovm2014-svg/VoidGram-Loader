{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidGram Loader",
  "version": "0.5.0",
  "identifier": "com.voidgram.loader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VoidGram Loader",
      "width": 1536,
      "height": 1024,
      "minWidth": 1100,
      "minHeight": 760,
      "center": true,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/idevice/**"]
  }
}