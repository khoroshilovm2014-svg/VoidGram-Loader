{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidGram Loader",
  "version": "0.4.1",
  "identifier": "com.voidgram.loader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VoidGram Loader",
      "width": 820,
      "height": 700,
      "minWidth": 650,
      "minHeight": 560
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}